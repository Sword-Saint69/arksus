{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nobetsu/ledger.schema.json",
  "title": "ledger",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mock": {
      "type": "boolean"
    },
    "generated_at": {
      "type": "string"
    },
    "location_id": {
      "enum": [
        "karapinar",
        "develi"
      ]
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_year": {
            "type": "integer"
          },
          "rotation_id": {
            "enum": [
              "fallow_wheat",
              "chickpea_wheat",
              "lentil_wheat"
            ]
          },
          "depth_id": {
            "enum": [
              "shallow",
              "medium",
              "deep"
            ]
          },
          "weeks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "week_start": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "p_mm": {
                  "type": "number"
                },
                "eta_mm": {
                  "type": "number"
                },
                "dp_mm": {
                  "type": "number"
                },
                "aw_mm": {
                  "type": "number"
                },
                "crop": {
                  "enum": [
                    "fallow",
                    "bare",
                    "wheat",
                    "chickpea",
                    "lentil"
                  ]
                }
              },
              "required": [
                "week_start",
                "p_mm",
                "eta_mm",
                "dp_mm",
                "aw_mm",
                "crop"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "start_year",
          "rotation_id",
          "depth_id",
          "weeks"
        ],
        "additionalProperties": false
      },
      "minItems": 216,
      "maxItems": 216
    }
  },
  "required": [
    "schema_version",
    "mock",
    "generated_at",
    "location_id",
    "series"
  ],
  "additionalProperties": false
}

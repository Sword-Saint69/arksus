  {
   "id": "phh2o",
   "label": {
    "en": "pH (water)",
    "tr": "pH (su)"
   },
   "depth": "0-30 cm",
   "q05": 6.05,
   "q50": 7.68,
   "q95": 8.55,
   "unit": "pH",
   "source": "SoilGrids 2.0 (ISRIC), WCS",
   "type": "model",
   "how_obtained": "wcs",
   "meaning": {
    "en": "A pH above 7 means alkaline, often limy soil; wheat, chickpea and lentil grow in it, but phosphorus and zinc can be less available, which a soil test shows.",
    "tr": "pH'nin 7'nin üzerinde olması bazik, çoğu zaman kireçli toprak demektir; buğday, nohut ve mercimek yetişir ama fosfor ve çinko daha az alınabilir, bunu toprak analizi gösterir."
   }
  },
  {
   "id": "soc",
   "label": {
    "en": "Soil organic carbon",
    "tr": "Toprak organik karbonu"
   },
   "depth": "0-30 cm",
   "q05": 2.9,
   "q50": 11.72,
   "q95": 52.45,
   "unit": "g/kg",
   "source": "SoilGrids 2.0 (ISRIC), WCS",
   "type": "model",
   "how_obtained": "wcs",
   "meaning": {
    "en": "Organic carbon keeps soil crumbly and helps it hold water; bare fallow and frequent tillage slowly lower it, while plant cover and residues build it up.",
    "tr": "Organik karbon toprağı gevşek tutar ve su tutmasına yardım eder; çıplak nadas ve sık toprak işleme onu yavaşça azaltır, bitki örtüsü ve artıklar artırır."
   }
  },
  {
